<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SepiaSharp.MainWindow"
        Title="SepiaSharp"
        CanMaximize="False"
        CanResize="False"
        Background="#202020"
        Width="800"
        Height="450">
    <Panel>
        <!--Menu Bar-->
        <Menu VerticalAlignment="Top" Background="#181818">
            <MenuItem Header="_Photos" Foreground="White">
                <MenuItem Header="_Save Photos" Click="SavePhoto" HotKey="Ctrl+S" InputGesture="ctrl+s"/>
                <MenuItem Header="_Load Photos" Click="LoadPhotos" HotKey="Ctrl+A" InputGesture="ctrl+A" />
            </MenuItem>
        </Menu>
        <!--Sidebar-->
        <Border Width="230" Height="370" VerticalAlignment="Center" 
        Background="#171717" HorizontalAlignment="Left" Margin="30,25,0,0" CornerRadius="15">
            <StackPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Sepia" Background="#232323" Foreground="White"
                Padding="50,10,78,10" Margin="0,0,0,10" Click="callSpeia"></Button>
                <Button Content="Greyscale" Background="#232323" Foreground="White"
                Padding="50,10,50,10" Margin="0,0,0,10" Click="callGrey"></Button>
                <Button Content="Invert" Background="#232323" Foreground="White"
                Padding="50,10,78,10" Margin="0,0,0,10" Click="callInvert"></Button>
                <Button Content="Saturate" Background="#232323" Foreground="White"
                Padding="50,10,60,10" Click="callSaturate"></Button>
                
            </StackPanel>
        </Border>
        <!--Image Output-->
        <Border Width="500" Height="350" HorizontalAlignment="Right" 
        Margin="0,20,20,0" Background="#181818" CornerRadius="10">
            <Image x:Name="OutputPanel" />
        </Border>
    </Panel>
</Window>
